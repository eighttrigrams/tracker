  "enc:v1:a task about the envelope!"
  "enc:v1:====="
  "enc:v1:AAAA"
  "enc:v1:AAA"
  "enc:v1:AAAAAAAAAAAAAAAA"
  "enc:v1:!!!"
  "enc:v1:%"],
